#!/usr/bin/env bash
# Tang — agentic foundations CLI for DataKnifeAI
set -euo pipefail

TANG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACKS_DIR="${TANG_ROOT}/packs"
SKILLS_SRC="${TANG_ROOT}/plugin/skills"
RULES_SRC="${TANG_ROOT}/templates/rules/tang.mdc"
FEATURE_MAP_SRC="${TANG_ROOT}/templates/FEATURE_MAP.md"
DEFAULT_PROJECTS_DIR="${HOME}/Projects"

usage() {
  cat <<'EOF'
tang — DataKnifeAI agentic foundations

Usage:
  tang init <name> [--lang <python|rust|go|node|shell>] [--dir <parent>]
  tang adopt [path]
  tang verify [path]
  tang status [path]
  tang help

Commands:
  init     Scaffold a new project with verify pack, skills, and Tang rule
  adopt    Wire an existing repo into Tang (detect lang, skills, manifest)
  verify   Run make verify in the target repo
  status   Show packs, skills, slashbay readiness hints
EOF
}

die() { echo "tang: $*" >&2; exit 1; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

detect_lang() {
  local root="$1"
  if [[ -f "${root}/Cargo.toml" ]]; then echo rust
  elif [[ -f "${root}/go.mod" ]]; then echo go
  elif [[ -f "${root}/pyproject.toml" || -f "${root}/requirements.txt" || -f "${root}/setup.py" ]]; then echo python
  elif [[ -f "${root}/package.json" ]]; then echo node
  else echo shell
  fi
}

valid_lang() {
  case "$1" in
    python|rust|go|node|shell) return 0 ;;
    *) return 1 ;;
  esac
}

write_manifest() {
  local root="$1" name="$2" lang="$3" slashbay_ready="${4:-false}"
  mkdir -p "${root}/.tang"
  cat >"${root}/.tang/manifest.yml" <<EOF
# Generated by tang — edit packs/feature_map as needed.
version: 1
name: ${name}
packs:
  - ${lang}
feature_map: docs/FEATURE_MAP.md
slashbay:
  ready: ${slashbay_ready}
  allowlist_hint: DataKnifeAI/${name}
skills:
  source: .cursor/skills
verify: make verify
EOF
}

install_skills() {
  local root="$1"
  mkdir -p "${root}/.cursor/skills"
  local skill
  for skill in "${SKILLS_SRC}"/*; do
    [[ -d "${skill}" ]] || continue
    local base
    base="$(basename "${skill}")"
    rm -rf "${root}/.cursor/skills/${base}"
    cp -a "${skill}" "${root}/.cursor/skills/${base}"
  done
}

install_rule() {
  local root="$1"
  mkdir -p "${root}/.cursor/rules"
  cp -f "${RULES_SRC}" "${root}/.cursor/rules/tang.mdc"
}

ensure_feature_map() {
  local root="$1"
  mkdir -p "${root}/docs"
  if [[ ! -f "${root}/docs/FEATURE_MAP.md" ]]; then
    cp -f "${FEATURE_MAP_SRC}" "${root}/docs/FEATURE_MAP.md"
  fi
}

ensure_gitignore_bits() {
  local root="$1"
  local gi="${root}/.gitignore"
  touch "${gi}"
  grep -qxF '.tang-tmp/' "${gi}" 2>/dev/null || echo '.tang-tmp/' >>"${gi}"
}

merge_verify_makefile() {
  local root="$1" lang="$2"
  local mf="${root}/Makefile"
  local pack_mf="${PACKS_DIR}/${lang}/Makefile.verify"

  if [[ ! -f "${mf}" ]]; then
    cat >"${mf}" <<'EOF'
# Tang-managed Makefile — agent gate is `verify`
.DEFAULT_GOAL := help

.PHONY: help

help:
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  %-16s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

include .tang/Makefile.verify
EOF
  elif ! grep -qE '^verify:|^verify ' "${mf}" && ! grep -q 'Makefile.verify' "${mf}"; then
    {
      echo ""
      echo "# --- Tang verify gate ---"
      echo "include .tang/Makefile.verify"
    } >>"${mf}"
  fi

  mkdir -p "${root}/.tang"
  cp -f "${pack_mf}" "${root}/.tang/Makefile.verify"

  # Vendored pack hints
  mkdir -p "${root}/.tang/pack"
  cp -a "${PACKS_DIR}/${lang}/." "${root}/.tang/pack/"

  case "${lang}" in
    python)
      if [[ ! -f "${root}/ruff.toml" ]]; then
        cp -f "${PACKS_DIR}/python/ruff.toml" "${root}/ruff.toml"
      fi
      ;;
  esac
}

print_slashbay_hint() {
  local name="$1"
  cat <<EOF

Slashbay allowlist (after the repo is under DataKnifeAI):
  DataKnifeAI/${name}

See: ${TANG_ROOT}/docs/SLASHBAY.md
EOF
}

cmd_init() {
  local name="" lang="shell" parent="${DEFAULT_PROJECTS_DIR}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lang)
        shift
        [[ $# -gt 0 ]] || die "--lang needs a value"
        lang="$1"
        ;;
      --dir)
        shift
        [[ $# -gt 0 ]] || die "--dir needs a value"
        parent="$1"
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      -*)
        die "unknown flag: $1"
        ;;
      *)
        if [[ -z "${name}" ]]; then name="$1"
        else die "unexpected argument: $1"
        fi
        ;;
    esac
    shift
  done

  [[ -n "${name}" ]] || die "init requires a project name"
  [[ "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die "invalid project name: ${name}"
  valid_lang "${lang}" || die "unsupported lang: ${lang} (python|rust|go|node|shell)"

  mkdir -p "${parent}"
  local root="${parent}/${name}"
  [[ ! -e "${root}" ]] || die "path already exists: ${root}"

  mkdir -p "${root}"
  if [[ ! -d "${root}/.git" ]]; then
    git -C "${root}" init -q
  fi

  # Minimal LICENSE pointer
  if [[ ! -f "${root}/LICENSE" ]]; then
    cat >"${root}/LICENSE" <<'EOF'
Apache License 2.0 — replace with the full license text when publishing.
Copyright DataKnifeAI
EOF
  fi

  if [[ ! -f "${root}/README.md" ]]; then
    cat >"${root}/README.md" <<EOF
# ${name}

Scaffolded by [Tang](https://github.com/DataKnifeAI/tang). Run \`make verify\` before claiming agent work done.

Language pack: **${lang}**
EOF
  fi

  write_manifest "${root}" "${name}" "${lang}" false
  merge_verify_makefile "${root}" "${lang}"
  install_skills "${root}"
  install_rule "${root}"
  ensure_feature_map "${root}"
  ensure_gitignore_bits "${root}"

  echo "initialized: ${root} (lang=${lang})"
  print_slashbay_hint "${name}"
}

cmd_adopt() {
  local root="${1:-.}"
  root="$(cd "${root}" && pwd)"
  [[ -d "${root}" ]] || die "not a directory: ${root}"

  local name lang
  name="$(basename "${root}")"
  lang="$(detect_lang "${root}")"
  valid_lang "${lang}" || die "could not detect language"

  write_manifest "${root}" "${name}" "${lang}" false
  merge_verify_makefile "${root}" "${lang}"
  install_skills "${root}"
  install_rule "${root}"
  ensure_feature_map "${root}"
  ensure_gitignore_bits "${root}"

  echo "adopted: ${root}"
  echo "detected pack: ${lang}"
  print_slashbay_hint "${name}"
  echo "Next: cd ${root} && make verify"
}

cmd_verify() {
  local root="${1:-.}"
  root="$(cd "${root}" && pwd)"
  [[ -f "${root}/Makefile" ]] || die "no Makefile in ${root} — run tang adopt first"
  make -C "${root}" verify
}

cmd_status() {
  local root="${1:-.}"
  root="$(cd "${root}" && pwd)"
  echo "tang root:  ${TANG_ROOT}"
  echo "target:     ${root}"
  if [[ -f "${root}/.tang/manifest.yml" ]]; then
    echo "manifest:   present"
    echo "---"
    cat "${root}/.tang/manifest.yml"
    echo "---"
  else
    echo "manifest:   missing (run tang adopt)"
  fi

  echo "skills:"
  if [[ -d "${root}/.cursor/skills" ]]; then
    find "${root}/.cursor/skills" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' 2>/dev/null \
      || find "${root}/.cursor/skills" -mindepth 1 -maxdepth 1 -type d | sed 's|.*/|  |'
  else
    echo "  (none)"
  fi

  if [[ -f "${root}/.cursor/rules/tang.mdc" ]]; then
    echo "rule:       .cursor/rules/tang.mdc"
  else
    echo "rule:       missing"
  fi

  if [[ -f "${root}/Makefile" ]] && grep -qE 'verify|Makefile.verify' "${root}/Makefile"; then
    echo "verify:     Makefile mentions verify"
  else
    echo "verify:     not wired"
  fi

  local name
  name="$(basename "${root}")"
  echo "slashbay:   add DataKnifeAI/${name} to SLASHBAY_REPO_ALLOWLIST when published"
  echo "docs:       ${TANG_ROOT}/docs/SLASHBAY.md"
}

cmd_check_skills() {
  local skill
  local count=0
  for skill in "${SKILLS_SRC}"/*; do
    [[ -d "${skill}" ]] || continue
    [[ -f "${skill}/SKILL.md" ]] || die "missing SKILL.md in $(basename "${skill}")"
    count=$((count + 1))
  done
  [[ "${count}" -ge 1 ]] || die "no skills under ${SKILLS_SRC}"
  echo "skills ok: ${count}"
}

cmd_list_skills() {
  local skill
  for skill in "${SKILLS_SRC}"/*; do
    [[ -d "${skill}" ]] || continue
    basename "${skill}"
  done
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "${cmd}" in
    init) cmd_init "$@" ;;
    adopt) cmd_adopt "$@" ;;
    verify) cmd_verify "$@" ;;
    status) cmd_status "$@" ;;
    help|-h|--help) usage ;;
    _check-skills) cmd_check_skills ;;
    _list-skills) cmd_list_skills ;;
    *) die "unknown command: ${cmd} (try tang help)" ;;
  esac
}

main "$@"
